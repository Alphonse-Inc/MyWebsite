Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(php|phtml|phar|phps|cgi|pl|py|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)\.(php|phtml|phar|phps|cgi|pl|py|sh)$">
        Deny from all
    </FilesMatch>
</IfModule>

RemoveHandler .php .phtml .phar .phps
RemoveType .php .phtml .phar .phps
# php_flag is omitted on purpose. On cPanel PHP-FPM and LiteSpeed it
# returns 500 for every file in this directory.
