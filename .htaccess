# Used only when the account document root is this project folder
# (the whole repository was uploaded into public_html). The preferred
# cPanel layout does not serve this file. See HOSTING.md.
Options -Indexes

<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|config|storage|vendor|database)(/|$) - [F,L]
    RewriteRule ^\.env - [F,L]
    RewriteRule \.(sql|lock)$ - [F,L]
    RewriteRule ^public_html/ - [L]
    RewriteCond %{REQUEST_URI} !^/public_html/
    RewriteRule ^(.*)$ public_html/$1 [L]
</IfModule>
