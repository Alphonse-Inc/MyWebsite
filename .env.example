# contact form if you are not entering SMTP under Admin → Settings.
# A host saved in Admin → Settings replaces these values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=iamemmaafolayan@gmail.com
SMTP_FROM_NAME=Emmanuel Afolayan

# Used only by database/seed_from_legacy.php while the old image files
# are still reachable. Leave empty to install the password hash documented
# in DEPLOYMENT.md. Set a new password to override.
